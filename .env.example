NODE_ENV=production
JWT_SECRET=mike
PORT=3333
#DATABASE_URL_EXAMPLE="postgresql://userName:password@localhost:5432/databaseName?schema=public"
DATABASE_URL=postgresql://docker:docker@api-solid-pg:5432/apisolid?schema=public
# PostgreSQL database variables
POSTGRESQL_USERNAME=docker   
POSTGRESQL_PASSWORD=docker
POSTGRESQL_DATABASE=apisolid
POSTGRESQL_DEFAULT_PORT=5432
## Change this port in case your local machine already have postgresql running on 5432
POSTGRESQL_LOCALHOST_PORT=5435